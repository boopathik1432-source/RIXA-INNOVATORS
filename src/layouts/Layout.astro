---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../data/siteConfig';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: {
    publishedTime: string;
    author: string;
    tags: string[];
  };
}

const {
  title = `${siteConfig.projectName} — ${siteConfig.tagline}`,
  description = siteConfig.description,
  image = 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=1200&q=80',
  article
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://rixa-innovators.network');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- SEO & Metadata -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="author" content={siteConfig.teamName} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content={siteConfig.projectName} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    
    <!-- Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <!-- Motion.dev Animation Orchestrator -->
    <script>
      // Initialize Motion.dev entrance animations and micro-interactions
      import { animate, inView } from 'motion';

      // Ensure respect for prefers-reduced-motion
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!prefersReducedMotion) {
        // Staggered reveal for interactive cards and editorial sections
        inView('.motion-reveal', (info) => {
          animate(
            info.target,
            { opacity: [0, 1], transform: ['translateY(24px)', 'translateY(0px)'] },
            { duration: 0.6, easing: [0.16, 1, 0.3, 1] }
          );
        });

        // Floating ambient nodes in Web3 visuals
        const floatNodes = document.querySelectorAll('.motion-float');
        floatNodes.forEach((node, i) => {
          animate(
            node,
            { transform: ['translateY(0px)', 'translateY(-8px)', 'translateY(0px)'] },
            { duration: 4 + i, repeat: Infinity, easing: 'ease-in-out' }
          );
        });
      }
    </script>
  </body>
</html>
