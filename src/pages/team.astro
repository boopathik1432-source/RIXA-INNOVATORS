---
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import TeamCard from '../components/TeamCard.astro';
import { teamMembers } from '../data/team';
import { siteConfig } from '../data/siteConfig';
---

<Layout
  title={`Team ${siteConfig.teamName} — Core Team (Size: ${siteConfig.teamSize})`}
  description={`Meet the 6 official members of the ${siteConfig.teamName} collective from Rathinam Global Deemed To Be University.`}
>
  <div class="team-page section-spacing">
    <div class="container">
      <!-- Hero Header -->
      <div class="team-hero-header">
        <div class="hero-badge motion-reveal">
          <span class="badge-dot"></span>
          <span>Official Team Collective</span>
        </div>

        <h1 class="hero-title motion-reveal">
          <span class="gradient-text">{siteConfig.teamName}</span>
        </h1>

        <p class="hero-desc motion-reveal">
          A specialized 6-member multidisciplinary collective combining Visual Communication, Media Arts, Journalism, and Interactive Web Architecture from <strong>Rathinam Global Deemed To Be University</strong>.
        </p>

        <!-- Stats Overview Banner -->
        <div class="stats-ribbon motion-reveal">
          <div class="stat-pill">
            <span class="stat-num">{siteConfig.teamSize}</span>
            <span class="stat-label">Core Members</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-pill">
            <span class="stat-num">2</span>
            <span class="stat-label">Academic Departments</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-pill">
            <span class="stat-num">RGU</span>
            <span class="stat-label">Global University</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-pill">
            <span class="stat-num">100%</span>
            <span class="stat-label">Dedicated Innovation</span>
          </div>
        </div>
      </div>

      <!-- Department Distribution Tags -->
      <div class="dept-summary-row motion-reveal">
        <div class="dept-chip">
          <span class="dept-indicator dept-bvc"></span>
          <span>B.Sc Visual Communication — School of Fashion Design, Media & Performing Arts</span>
        </div>
        <div class="dept-chip">
          <span class="dept-indicator dept-mjc"></span>
          <span>M.A Journalism & Mass Communication — School of Liberal Arts & Science</span>
        </div>
      </div>

      <!-- Team Members Grid -->
      <div class="team-grid">
        {teamMembers.map((member, index) => (
          <TeamCard member={member} index={index + 1} />
        ))}
      </div>

      <!-- Academic Collective Banner -->
      <div class="institution-banner motion-reveal">
        <div class="institution-content">
          <div class="institution-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
              <path d="M6 12v5c3 3 9 3 12 0v-5"/>
            </svg>
          </div>
          <div class="institution-texts">
            <h3>Rathinam Global Deemed To Be University</h3>
            <p>
              Premier multidisciplinary institution. Team <strong>{siteConfig.teamName}</strong> represents collaborative research bridging visual storytelling, digital interfaces, and modern media communication.
            </p>
          </div>
        </div>

        <div class="institution-actions">
          <a href="mailto:contact@rixa-innovators.network" class="btn btn-primary">
            <span>Contact Team Collective</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .team-page {
    padding-top: 4.5rem;
    padding-bottom: 6rem;
  }

  .team-hero-header {
    text-align: center;
    max-width: 860px;
    margin: 0 auto 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border-radius: var(--radius-full);
    background: var(--accent-primary-light);
    color: var(--accent-primary);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: 1px solid rgba(79, 70, 229, 0.2);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-primary);
    box-shadow: 0 0 8px var(--accent-primary);
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 3.85rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--text-primary);
  }

  .gradient-text {
    background: var(--grad-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-desc {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 740px;
  }

  .stats-ribbon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 2rem;
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: 1.25rem 2.5rem;
    margin-top: 1rem;
    box-shadow: var(--shadow-sm);
  }

  .stat-pill {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
  }

  .stat-num {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--accent-primary);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .stat-divider {
    width: 1px;
    height: 32px;
    background: var(--border-subtle);
  }

  /* Department summary chips */
  .dept-summary-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .dept-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(241, 245, 249, 0.7);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    padding: 0.5rem 1.1rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .dept-indicator {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dept-bvc {
    background: #4f46e5;
    box-shadow: 0 0 6px rgba(79, 70, 229, 0.5);
  }

  .dept-mjc {
    background: #06b6d4;
    box-shadow: 0 0 6px rgba(6, 182, 212, 0.5);
  }

  /* Team Grid */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    margin-bottom: 4rem;
  }

  /* Institution Banner */
  .institution-banner {
    background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
    border-radius: var(--radius-xl);
    padding: 3rem 2.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    color: #ffffff;
    box-shadow: var(--shadow-xl);
  }

  .institution-content {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .institution-icon {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #38bdf8;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .institution-texts h3 {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.5rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 0.5rem;
  }

  .institution-texts p {
    font-size: 0.95rem;
    color: #94a3b8;
    line-height: 1.6;
    max-width: 620px;
  }

  .institution-actions {
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .team-grid {
      grid-template-columns: 1fr;
    }

    .institution-banner {
      flex-direction: column;
      align-items: flex-start;
      padding: 2.25rem 1.75rem;
    }

    .stat-divider {
      display: none;
    }

    .stats-ribbon {
      gap: 1.25rem;
      padding: 1.25rem;
    }
  }
</style>
