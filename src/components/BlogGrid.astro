---
import BlogCard from './BlogCard.astro';
import type { BlogPost } from '../data/blogs';

interface Props {
  posts: BlogPost[];
  showFilter?: boolean;
}

const { posts, showFilter = true } = Astro.props;

// Get unique categories from actual posts
const categories = ['All', ...Array.from(new Set(posts.map(p => p.category)))];
---

<div class="blog-grid-system">
  {showFilter && (
    <div class="category-filter-bar">
      <div class="filter-pills" role="tablist" aria-label="Article categories">
        {categories.map((cat, index) => (
          <button
            class:list={['filter-pill', { 'active': index === 0 }]}
            data-category={cat}
            role="tab"
            aria-selected={index === 0 ? "true" : "false"}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>
  )}

  <div class="blog-grid" id="blog-posts-container">
    {posts.map((post, index) => (
      <div class="grid-item" data-category={post.category}>
        <BlogCard post={post} featured={index === 0} />
      </div>
    ))}
  </div>

  <div id="no-results-msg" class="no-results" style="display: none;">
    <p>No articles found in this category.</p>
  </div>
</div>

<style>
  .blog-grid-system {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .category-filter-bar {
    display: flex;
    justify-content: center;
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }

  .filter-pills {
    display: flex;
    gap: 0.5rem;
    background: var(--bg-secondary);
    padding: 0.35rem 0.5rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--border-subtle);
    max-width: 100%;
  }

  .filter-pill {
    background: transparent;
    border: none;
    padding: 0.45rem 1.1rem;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .filter-pill:hover {
    color: var(--text-primary);
  }

  .filter-pill.active {
    background: #ffffff;
    color: var(--text-primary);
    box-shadow: var(--shadow-sm);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .grid-item {
    display: flex;
    flex-direction: column;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .no-results {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  @media (max-width: 768px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const filterPills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
  const items = document.querySelectorAll<HTMLElement>('.grid-item');
  const noResults = document.getElementById('no-results-msg');

  filterPills.forEach(pill => {
    pill.addEventListener('click', () => {
      // Update active state
      filterPills.forEach(p => {
        p.classList.remove('active');
        p.setAttribute('aria-selected', 'false');
      });
      pill.classList.add('active');
      pill.setAttribute('aria-selected', 'true');

      const selectedCategory = pill.getAttribute('data-category');
      let visibleCount = 0;

      items.forEach(item => {
        const itemCategory = item.getAttribute('data-category');
        if (selectedCategory === 'All' || itemCategory === selectedCategory) {
          item.style.display = 'flex';
          item.style.opacity = '1';
          visibleCount++;
        } else {
          item.style.display = 'none';
          item.style.opacity = '0';
        }
      });

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    });
  });
</script>
