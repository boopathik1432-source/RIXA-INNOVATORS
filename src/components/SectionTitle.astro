---
interface Props {
  badge?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}

const {
  badge,
  title,
  description,
  align = 'center'
} = Astro.props;
---

<div class:list={['section-header', `align-${align}`, 'motion-reveal']}>
  {badge && (
    <div class="badge-wrapper">
      <span class="badge">
        <span class="badge-dot"></span>
        {badge}
      </span>
    </div>
  )}
  <h2 class="section-title">{title}</h2>
  {description && <p class="section-desc">{description}</p>}
</div>

<style>
  .section-header {
    margin-bottom: 3.5rem;
  }

  .align-center {
    text-align: center;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }

  .align-left {
    text-align: left;
    max-width: 720px;
  }

  .badge-wrapper {
    margin-bottom: 1rem;
  }

  .section-title {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.2;
    margin-bottom: 0.85rem;
    letter-spacing: -0.025em;
  }

  .section-desc {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
</style>
