---
import { siteConfig } from '../data/siteConfig';
---

<section class="hero-section">
  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-badge-wrap motion-reveal">
        <span class="badge">
          <span class="badge-dot"></span>
          {siteConfig.projectName} • {siteConfig.domain}
        </span>
      </div>

      <h1 class="hero-title motion-reveal">
        From Memorizing Concepts to <span class="gradient-text">Experiencing Them</span>.
      </h1>

      <p class="hero-description motion-reveal">
        An engineering publication deciphering multimodal AI curriculum generation, smartphone-based augmented reality, and decentralized verifiable knowledge networks.
      </p>

      <div class="hero-ctas motion-reveal">
        <a href="/blog" class="btn btn-primary">
          <span>Explore Articles</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a href="/about" class="btn btn-secondary">
          <span>About Our Team</span>
        </a>
      </div>

      <div class="hero-trust-metrics motion-reveal">
        <div class="metric-item">
          <span class="metric-val">5+</span>
          <span class="metric-lbl">In-Depth Guides</span>
        </div>
        <div class="metric-sep"></div>
        <div class="metric-item">
          <span class="metric-val">WebXR</span>
          <span class="metric-lbl">Smartphone Native</span>
        </div>
        <div class="metric-sep"></div>
        <div class="metric-item">
          <span class="metric-val">Web3</span>
          <span class="metric-lbl">Verifiable Credentials</span>
        </div>
      </div>
    </div>

    <!-- Web3-inspired abstract visual composition -->
    <div class="hero-visual" aria-hidden="true">
      <div class="visual-canvas">
        <!-- Abstract glowing orb -->
        <div class="ambient-glow"></div>

        <!-- Layered Floating Web3 Cards -->
        <div class="floating-card card-top motion-float">
          <div class="card-pill">
            <span class="pill-dot emerald"></span>
            <span>AI Content Pipeline Active</span>
          </div>
          <div class="card-row">
            <span class="metric-code">Subject: Quantum Fields</span>
            <span class="status-chip">Synthesized</span>
          </div>
          <div class="progress-bar">
            <div class="progress-fill" style="width: 88%;"></div>
          </div>
        </div>

        <div class="floating-card card-center">
          <div class="card-header-clean">
            <div class="symbol-box">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="12 2 2 7 12 12 22 7 12 2" fill="rgba(79, 70, 229, 0.1)"></polygon>
                <polyline points="2 17 12 22 22 17"></polyline>
                <polyline points="2 12 12 17 22 12"></polyline>
              </svg>
            </div>
            <div>
              <div class="card-label">Spatial Interaction Core</div>
              <div class="card-sub">QR ──> WebXR Plane Lock</div>
            </div>
          </div>
          <!-- Geometric vector grid -->
          <div class="grid-mesh-preview">
            <svg width="100%" height="80" viewBox="0 0 300 80" fill="none">
              <path d="M10 60 Q 75 10, 150 40 T 290 20" stroke="url(#lineGrad)" stroke-width="2.5" fill="none" />
              <path d="M10 70 Q 80 30, 160 50 T 290 35" stroke="rgba(8, 145, 178, 0.3)" stroke-width="1.5" stroke-dasharray="4 4" fill="none" />
              <defs>
                <linearGradient id="lineGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#4f46e5" />
                  <stop offset="100%" stop-color="#0891b2" />
                </linearGradient>
              </defs>
            </svg>
          </div>
          <div class="card-footer-metrics">
            <span>Latency: 12ms</span>
            <span>Mesh Anchors: 1,420</span>
          </div>
        </div>

        <div class="floating-card card-bottom motion-float" style="animation-delay: -2s;">
          <div class="card-pill">
            <span class="pill-dot violet"></span>
            <span>ZK-Attestation Node</span>
          </div>
          <div class="credential-hash">
            <code>0x8f2d...4a9e [Soulbound Verified]</code>
          </div>
        </div>

        <!-- Geometric accents -->
        <div class="geometric-ring ring-1"></div>
        <div class="geometric-ring ring-2"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-top: 5rem;
    padding-bottom: 5.5rem;
    overflow: hidden;
    background: radial-gradient(circle at 80% 20%, rgba(99, 102, 241, 0.05) 0%, transparent 60%);
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: center;
    gap: 4rem;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hero-badge-wrap {
    margin-bottom: 0.25rem;
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 3.85rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .gradient-text {
    background: var(--grad-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-description {
    font-size: 1.18rem;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 540px;
  }

  .hero-ctas {
    display: flex;
    gap: 1rem;
    margin-top: 0.75rem;
    flex-wrap: wrap;
  }

  .hero-trust-metrics {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border-subtle);
  }

  .metric-item {
    display: flex;
    flex-direction: column;
  }

  .metric-val {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.1;
  }

  .metric-lbl {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .metric-sep {
    width: 1px;
    height: 28px;
    background: var(--border-subtle);
  }

  /* Visual Composition */
  .hero-visual {
    position: relative;
    width: 100%;
    min-height: 440px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .visual-canvas {
    position: relative;
    width: 100%;
    max-width: 480px;
    height: 420px;
  }

  .ambient-glow {
    position: absolute;
    top: 20%;
    left: 15%;
    width: 280px;
    height: 280px;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.15) 0%, rgba(8, 145, 178, 0.1) 50%, transparent 70%);
    filter: blur(40px);
    pointer-events: none;
    z-index: 0;
  }

  .floating-card {
    position: absolute;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    z-index: 1;
    transition: transform 0.3s ease;
  }

  .card-top {
    top: 5px;
    right: 10px;
    width: 240px;
    padding: 1.1rem;
  }

  .card-center {
    top: 100px;
    left: 20px;
    right: 40px;
    padding: 1.6rem;
    box-shadow: var(--shadow-xl);
    border-color: rgba(79, 70, 229, 0.2);
  }

  .card-bottom {
    bottom: 10px;
    left: 45px;
    width: 280px;
    padding: 1rem 1.25rem;
  }

  .card-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .pill-dot.emerald {
    background: var(--accent-emerald);
    box-shadow: 0 0 8px var(--accent-emerald);
  }

  .pill-dot.violet {
    background: var(--accent-primary);
    box-shadow: 0 0 8px var(--accent-primary);
  }

  .card-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.6rem;
  }

  .metric-code {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .status-chip {
    font-size: 0.68rem;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-sm);
    background: var(--accent-emerald-light);
    color: var(--accent-emerald);
    font-weight: 600;
  }

  .progress-bar {
    width: 100%;
    height: 5px;
    background: var(--bg-tertiary);
    border-radius: 3px;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: var(--grad-primary);
    border-radius: 3px;
  }

  .card-header-clean {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }

  .symbol-box {
    width: 42px;
    height: 42px;
    border-radius: var(--radius-md);
    background: var(--accent-primary-light);
    color: var(--accent-primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-label {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .card-sub {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
  }

  .grid-mesh-preview {
    margin-bottom: 1rem;
    background: var(--bg-secondary);
    border-radius: var(--radius-sm);
    padding: 0.5rem;
    border: 1px solid var(--border-light);
  }

  .card-footer-metrics {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    font-family: 'JetBrains Mono', monospace;
    color: var(--text-muted);
  }

  .credential-hash code {
    font-size: 0.75rem;
    color: var(--accent-primary);
    background: var(--accent-primary-light);
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .geometric-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px dashed rgba(203, 213, 225, 0.6);
    pointer-events: none;
  }

  .ring-1 {
    width: 380px;
    height: 380px;
    top: 20px;
    left: 50px;
  }

  .ring-2 {
    width: 260px;
    height: 260px;
    top: 80px;
    left: 110px;
    border-color: rgba(99, 102, 241, 0.15);
  }

  @media (max-width: 960px) {
    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 3rem;
    }
    .hero-content {
      align-items: center;
    }
    .hero-description {
      margin-left: auto;
      margin-right: auto;
    }
    .hero-ctas {
      justify-content: center;
    }
    .hero-trust-metrics {
      justify-content: center;
    }
    .hero-visual {
      min-height: 380px;
    }
    .visual-canvas {
      max-width: 400px;
    }
  }

  @media (max-width: 500px) {
    .card-center {
      left: 10px;
      right: 10px;
    }
    .card-top {
      right: 0;
    }
    .card-bottom {
      left: 10px;
    }
  }
</style>
