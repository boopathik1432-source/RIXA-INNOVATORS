---
import { siteConfig } from '../data/siteConfig';
---

<section class="newsletter-section motion-reveal">
  <div class="newsletter-card">
    <div class="newsletter-glow" aria-hidden="true"></div>
    <div class="newsletter-content">
      <span class="badge">
        <span class="badge-dot"></span>
        Technical Dispatch
      </span>
      <h3 class="newsletter-title">Stay at the Frontier of Web3 & Smart Education</h3>
      <p class="newsletter-desc">
        Receive curated architectural teardowns, WebXR release patterns, and decentralized credential research directly from the {siteConfig.teamName} engineering lab. Zero spam, unsubscribe anytime.
      </p>

      <form class="newsletter-form" id="newsletter-form" onsubmit="event.preventDefault(); document.getElementById('newsletter-success').style.display = 'block'; this.style.display = 'none';">
        <div class="input-wrapper">
          <svg class="mail-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect width="20" height="16" x="2" y="4" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
          <input
            type="email"
            placeholder="Enter your academic or work email"
            required
            class="email-input"
            aria-label="Email address for technical newsletter"
          />
        </div>
        <button type="submit" class="btn btn-primary btn-newsletter">
          <span>Subscribe</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </button>
      </form>

      <div id="newsletter-success" class="newsletter-success-msg" style="display: none;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent-emerald)" stroke-width="2.5">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>Thank you for subscribing! You'll receive our next research dispatch.</span>
      </div>

      <div class="newsletter-perks">
        <span>✓ Bi-weekly deep dives</span>
        <span>✓ Verifiable code samples</span>
        <span>✓ Open-source tools</span>
      </div>
    </div>
  </div>
</section>

<style>
  .newsletter-section {
    padding-top: 2rem;
    padding-bottom: 5rem;
  }

  .newsletter-card {
    position: relative;
    background: #ffffff;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    padding: 4rem 2rem;
    overflow: hidden;
    box-shadow: var(--shadow-md);
    text-align: center;
  }

  .newsletter-glow {
    position: absolute;
    top: -50%;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 350px;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.08) 0%, rgba(8, 145, 178, 0.05) 50%, transparent 70%);
    pointer-events: none;
  }

  .newsletter-content {
    position: relative;
    z-index: 1;
    max-width: 620px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .newsletter-title {
    font-size: clamp(1.75rem, 3.5vw, 2.35rem);
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .newsletter-desc {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .newsletter-form {
    display: flex;
    gap: 0.75rem;
    width: 100%;
    max-width: 520px;
    margin-top: 0.75rem;
  }

  .input-wrapper {
    position: relative;
    flex-grow: 1;
    display: flex;
    align-items: center;
  }

  .mail-icon {
    position: absolute;
    left: 1rem;
    color: var(--text-subtle);
    pointer-events: none;
  }

  .email-input {
    width: 100%;
    padding: 0.85rem 1rem 0.85rem 2.75rem;
    font-size: 0.95rem;
    font-family: inherit;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--bg-secondary);
    color: var(--text-primary);
    transition: all 0.2s ease;
  }

  .email-input:focus {
    background: #ffffff;
    border-color: var(--accent-primary);
    box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
  }

  .btn-newsletter {
    white-space: nowrap;
    padding: 0.85rem 1.6rem;
  }

  .newsletter-success-msg {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius-md);
    background: var(--accent-emerald-light);
    color: var(--accent-emerald);
    font-weight: 600;
    font-size: 0.92rem;
    border: 1px solid rgba(5, 150, 105, 0.2);
  }

  .newsletter-perks {
    display: flex;
    gap: 1.5rem;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-top: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (max-width: 600px) {
    .newsletter-card {
      padding: 2.5rem 1.5rem;
    }
    .newsletter-form {
      flex-direction: column;
    }
    .btn-newsletter {
      width: 100%;
    }
  }
</style>
